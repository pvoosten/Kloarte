    <ProjectReference Include="../Kloarte.Mcp/Kloarte.Mcp.csproj" />
    <ProjectReference Include="../Kloarte.GodotBinding/Kloarte.GodotBinding.csproj" />
    <ProjectReference Include="../Kloarte.Application/Kloarte.Application.csproj" />
  </ItemGroup>
</Project>