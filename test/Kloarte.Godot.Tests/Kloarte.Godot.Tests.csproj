<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!--
    The Godot tests (rendered captures, diagnostics, binding tests): a Godot project of their own. Before every build
    the host's scenes, scripts and assets are copied in (git-ignored, see .gitignore) and its project.godot is copied
    with this project's name and assembly, so the tests run the app's real scenes while the host keeps no test code.
    Run:  <godot>_console.exe [-headless] -path test/Kloarte.Godot.Tests res://tests/<scene>.tscn
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Kloarte.Tests</RootNamespace>
    <!-- Code style: every public type and member has an XML doc comment (missing ones are warning CS1591). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <HostDir>$(MSBuildThisFileDirectory)../../src/Kloarte.Host/</HostDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Kloarte.Model/Kloarte.Model.csproj" />
    <ProjectReference Include="../../src/Kloarte.Yaml/Kloarte.Yaml.csproj" />
    <ProjectReference Include="../../src/Kloarte.MagicQ/Kloarte.MagicQ.csproj" />
    <ProjectReference Include="../../src/Kloarte.GodotBinding/Kloarte.GodotBinding.csproj" />
    <ProjectReference Include="../../src/Kloarte.Application/Kloarte.Application.csproj" />
  </ItemGroup>

  <UsingTask TaskName="CopyGodotSettings" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        // The host's project settings with this project's name and assembly (written only when they change).
        string text = System.IO.File.ReadAllText(Source);
        text = System.Text.RegularExpressions.Regex.Replace(text, "config/name=\"[^\"]*\"", "config/name=\"Kloarte tests\"");
        text = System.Text.RegularExpressions.Regex.Replace(text, "project/assembly_name=\"[^\"]*\"", "project/assembly_name=\"Kloarte.Godot.Tests\"");
        if (!System.IO.File.Exists(Destination) || System.IO.File.ReadAllText(Destination) != text)
            System.IO.File.WriteAllText(Destination, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CopyHost" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <HostFile Include="$(HostDir)**/*"
                Exclude="$(HostDir).godot/**;$(HostDir)Projects/**;$(HostDir)bin/**;$(HostDir)obj/**;$(HostDir)*.csproj;$(HostDir)project.godot;$(HostDir)export_presets.cfg;$(HostDir)**/*.uid" />
    </ItemGroup>
    <Copy SourceFiles="@(HostFile)" DestinationFiles="@(HostFile->'$(MSBuildThisFileDirectory)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <CopyGodotSettings Source="$(HostDir)project.godot" Destination="$(MSBuildThisFileDirectory)project.godot" />
    <ItemGroup>
      <!-- Copied host scripts that the project evaluation didn't see yet (first build). -->
      <Compile Include="$(MSBuildThisFileDirectory)host/**/*.cs;$(MSBuildThisFileDirectory)render/**/*.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>
</Project>
